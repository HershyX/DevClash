{
  "name": "devclash",
  "version": "1.0.0",
  "private": true,
  "description": "DevClash — full-stack competitive coding platform (React + Express + MongoDB)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "mongo:up": "docker compose up -d",
    "mongo:down": "docker compose down",
    "seed": "npm run seed --prefix backend",
    "verify": "node backend/scripts/verify-milestone.mjs && node backend/scripts/verify-adaptive-solve.mjs"
  }
}
